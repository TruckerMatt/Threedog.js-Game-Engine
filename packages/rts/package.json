{
  "name": "@threedog/rts",
  "version": "0.1.0",
  "description": "Deterministic RTS simulation for threedog: fixed-point math, units, flow-field movement, combat, fog of war, lockstep netcode. No three.js, runs in page, worker or Node",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "./index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./fixed": {
      "types": "./fixed.d.ts",
      "default": "./fixed.js"
    },
    "./examples/*": "./examples/*",
    "./package.json": "./package.json"
  },
  "files": [
    "*.js",
    "*.mjs",
    "*.d.ts",
    "modes",
    "net",
    "examples",
    "docs"
  ],
  "types": "./index.d.ts"
}
